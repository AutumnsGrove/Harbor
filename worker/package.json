{
	"name": "harbor-worker",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
