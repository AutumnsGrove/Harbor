# Harbor — copy to .env beside docker-compose.yml, then chmod 600.
#
# The update watcher rewrites exactly one line of this file (HARBOR_IMAGE) and
# preserves every other byte, including comments and secrets. Keep it that way:
# the watcher validates the value and refuses anything but
# <repo>@sha256:<64 hex> once the first update has run.

# The pinned artifact. `latest` until the first update; the watcher replaces it
# with a digest and never goes back to a tag.
HARBOR_IMAGE=ghcr.io/autumnsgrove/harbor:latest

# Host-side identity for the published port and the data volume.
HARBOR_UID=1000
HARBOR_GID=1000
# The port on 127.0.0.1 that `tailscale serve` proxies. 8897 is free (spike S7);
# 8895 is Pixelsort. Inside the container the process always listens on 8080.
HARBOR_HOST_PORT=8897

# Container paths. Absolute, because the root filesystem is read-only.
HARBOR_DATA_DIR=/data
HARBOR_UPDATE_DIR=/update-signal
HARBOR_DEPLOYMENT=docker

# The one Tailscale login allowed to read or write. tailscale serve sets and
# overwrites Tailscale-User-Login, so a tailnet client cannot forge it (S10).
HARBOR_ALLOWED_LOGIN=you@example.com

# Hostnames this app answers to. Hostnames only: no scheme, no port. The Docker
# healthcheck uses 127.0.0.1, Meridian probes localhost, and the tailnet uses the
# ts.net name, so all three must be listed.
HARBOR_ALLOWED_HOSTS=lepotato.taild95077.ts.net,localhost,127.0.0.1

# Phase 1: the Cloudflare Worker URL and the potato-scope token. Leave empty
# until the Worker is deployed; an empty value is parsed, not crashed on.
HARBOR_WORKER_URL=
HARBOR_WORKER_TOKEN=

# Phase 3: enrichment. One key, all AI through Nova.
OPENROUTER_API_KEY=
