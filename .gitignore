# OS / editor
.DS_Store
*.swp

# Secrets. The example is tracked on purpose: it is the list of names, never a
# value.
.env
.env.*
!.env.example
.dev.vars
wrangler.toml.local

# Local data
data/
update-signal/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build output
bin/
dist/
node_modules/

# The frontend build is produced by `make web`, CI and the Docker frontend stage.
# Only the placeholder is tracked, so source and output cannot drift.
web/build/*
!web/build/.gitkeep
web/.svelte-kit/
web/node_modules/
