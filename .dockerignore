# Source only. Everything the image builds — the frontend, the Go binary — is
# produced inside the build stages, so no build output, no local data and no
# repository metadata belongs in the context (design.md §3).

.git
.gitignore
.github

# Local runtime state, never in an image layer
.env
.env.*
data/
update-signal/
bin/
*.db
*.db-shm
*.db-wal

# Generated on the build machine
web/build
web/node_modules
web/.svelte-kit
node_modules

# Not needed to compile; keeps the context small and the layer cache honest
docs
design
deploy
scripts
*.md

# Editor and OS noise
.DS_Store
*.swp
